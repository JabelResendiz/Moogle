@page "/"
@inject SearchService SearchService

<PageTitle>Moogle Search</PageTitle>

<main class="search-page">
    <header class="search-header">
        <p class="eyebrow">Document search</p>
        <h1>Moogle</h1>
        <p>Find relevant passages across the indexed documents.</p>
    </header>

    <SearchBox OnSearch="RunSearchAsync" IsBusy="isSearching" />

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="error-message" role="alert">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(result?.Suggestion))
    {
        <p class="suggestion" role="status">
            Did you mean
            <button type="button" class="suggestion-button" @onclick="UseSuggestionAsync">
                @result.Suggestion
            </button>?
        </p>
    }

    <SearchResults Result="result" HasSearched="hasSearched" IsBusy="isSearching" />
</main>

@code {
    private SearchResult? result;
    private string? errorMessage;
    private bool hasSearched;
    private bool isSearching;

    private async Task RunSearchAsync(string query)
    {
        await ExecuteSearchAsync(query);
    }

    private async Task UseSuggestionAsync()
    {
        if (!string.IsNullOrWhiteSpace(result?.Suggestion))
        {
            await ExecuteSearchAsync(result.Suggestion);
        }
    }

    private async Task ExecuteSearchAsync(string query)
    {
        isSearching = true;
        errorMessage = null;

        try
        {
            result = await Task.Run(() => SearchService.Search(query));
            hasSearched = true;
        }
        catch (Exception)
        {
            result = null;
            errorMessage = "The search could not be completed. Please try again.";
        }
        finally
        {
            isSearching = false;
        }
    }
}

